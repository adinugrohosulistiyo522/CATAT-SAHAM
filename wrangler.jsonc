{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catat-saham",
  "main": "./worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
